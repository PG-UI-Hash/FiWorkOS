Window.SetBackgroundTopColor(0.04, 0.07, 0.13);
Window.SetBackgroundBottomColor(0.04, 0.07, 0.13);
logo_image = Image("phi.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 34);
message_image = Image.Text("By Pratham Tech.", 0.72, 0.80, 0.91);
message_sprite = Sprite(message_image);
message_sprite.SetX(Window.GetWidth() / 2 - message_image.GetWidth() / 2);
message_sprite.SetY(Window.GetHeight() / 2 + 88);
